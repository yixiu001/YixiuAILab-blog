<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="<%= url_for('/favicon.ico') %>">
  <link rel="icon" type="image/png" sizes="192x192" href="<%= url_for('/favicon-192.png') %>">
  <link rel="apple-touch-icon" href="<%= url_for('/apple-touch-icon.png') %>">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <%
    var seoBase = String(config.url || '').replace(/\/+$/, '');
    var seoRel = String(page.path || '').replace(/^\/+/, '');
    if (seoRel === 'index.html') seoRel = '';
    var seoCanonical = seoRel ? (seoBase + '/' + seoRel.replace(/\/$/, '') + '/') : (seoBase + '/');
    var seoDesc = page.description || page.summary || config.description || '';
    var seoTitle = page.title ? (page.title + ' · ' + config.title) : config.title;
    var seoCover = coverFor(page.cover, page.path) || '/images/logo.png';
    var seoImage = /^https?:\/\//i.test(seoCover)
      ? seoCover
      : seoBase + '/' + seoCover.replace(/^\/+/, '');
    var seoType = (page.layout === 'post' || page.layout === 'course') ? 'article' : 'website';
  %>
  <meta name="description" content="<%= seoDesc %>">
  <link rel="canonical" href="<%= seoCanonical %>">
  <meta property="og:type" content="<%= seoType %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= seoTitle %>">
  <meta property="og:description" content="<%= seoDesc %>">
  <meta property="og:url" content="<%= seoCanonical %>">
  <meta property="og:image" content="<%= seoImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seoTitle %>">
  <meta name="twitter:description" content="<%= seoDesc %>">
  <meta name="twitter:image" content="<%= seoImage %>">
  <% var authCfg = theme.auth || {}; %>
  <link rel="preload" as="style" href="<%= assetUrl('/css/style.css') %>">
  <link rel="stylesheet" href="<%= assetUrl('/css/style.css') %>">
  <% if(authCfg.enable === true && authCfg.api){ %>
  <link rel="preconnect" href="<%= authCfg.api %>" crossorigin>
  <% } %>
  <script>
    window.__YIXIU_AUTH = {
      enable: <%= authCfg.enable === true ? 'true' : 'false' %>,
      api: <%- JSON.stringify(String(authCfg.api || '')).replace(/</g, '\\u003c') %>
    };
    window.__YIXIU_QR = <%- JSON.stringify(assetUrl('/js/qrcode.min.js')).replace(/</g, '\\u003c') %>;
  </script>
  <%- css([]) %>
</head>
<body>
  <%- partial('_partial/icons') %>
  <%- partial('_partial/header') %>
  <%# auth.js 紧随 header 同步执行：解析到导航时即刻用缓存资料渲染登录态，首屏不空白、刷新不闪 %>
  <script src="<%= assetUrl('/js/auth.js') %>"></script>
  <main class="page-main"><%- body %></main>
  <%- partial('_partial/footer') %>
  <script defer src="<%= assetUrl('/js/main.js') %>"></script>
</body>
</html>
