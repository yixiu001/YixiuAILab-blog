<%
  // 评论区组件（文章页 + 课程章节页共用）
  // 静态站点没有后端，评论依赖外部服务。
  // 配置统一在站点根 _config.yml 的 services 段：接口地址 services.api、开关 services.comments。
  // provider: cloudflare（自建 Workers + D1，推荐）/ giscus / twikoo / waline
  // 未配置凭证 → 显示「待接入」提示，不伪造评论、不伪装可提交。
  var apiCfg = serviceApi();
  var cm = serviceCfg('comments');
  var cmProvider = String(cm.provider || 'cloudflare').toLowerCase();
  var g  = cm.giscus || {};
  var tk = cm.twikoo || {};
  var wa = cm.waline || {};

  var cfReady = !!apiCfg.base;
  var gReady  = !!(String(g.repo || '').trim() && String(g.repo_id || '').trim() && String(g.category_id || '').trim());
  var tkReady = !!String(tk.env_id || '').trim();
  var waReady = !!String(wa.server_url || '').trim();
  var cmReady = cm.enable === true && (
    (cmProvider === 'cloudflare' && cfReady) ||
    (cmProvider === 'giscus' && gReady) ||
    (cmProvider === 'twikoo' && tkReady) ||
    (cmProvider === 'waline' && waReady)
  );

  // 把配置安全注入前端脚本（避免 </script> 截断）
  function jsLit(v){ return JSON.stringify(String(v == null ? '' : v)).replace(/</g, '\\u003c'); }
%>
<section class="cm-block" id="comments">
  <div class="cm-head">
    <span class="cm-ic" aria-hidden="true">&#128172;</span>
    <div class="cm-head-tx">
      <h2>评论</h2>
      <p>有疑问、勘误或想聊的，欢迎在下面留言</p>
    </div>
  </div>

  <% if(cmReady && cmProvider === 'cloudflare'){ %>
  <!-- Cloudflare Workers + D1：前端直连自建 API，数据在自己手里 -->
  <div class="cm-body">
    <!-- 未登录：不开放评论输入，只给登录入口 -->
    <div class="cm-gate" id="cm-gate">
      <span class="cm-gate-ic"><svg class="sicon"><use href="#i-github"></use></svg></span>
      <div class="cm-gate-tx">登录后即可参与评论<small>使用 GitHub 账号，评论会自动署名</small></div>
      <button class="cm-gate-btn" id="cm-login-btn" type="button">GitHub 登录</button>
    </div>
    <form class="cm-form" id="cm-form" autocomplete="off" hidden>
      <textarea class="cm-textarea" id="cm-content" maxlength="500" rows="3" placeholder="说点什么吧…（支持纯文本，最多 500 字）" aria-label="评论内容" required></textarea>
      <div class="cm-form-foot">
        <span class="cm-count" id="cm-count">0 / 500</span>
        <button class="cm-submit" id="cm-submit" type="submit">发表评论</button>
      </div>
    </form>
    <div class="cm-status" id="cm-status"></div>
    <div class="cm-list" id="cm-list"></div>
  </div>
  <script>
  (function(){
    var API = <%- jsLit(apiCfg.base + '/api/comments') %>;
    var PAGE = location.pathname;
    var form = document.getElementById('cm-form');
    var gate = document.getElementById('cm-gate');
    var loginBtn = document.getElementById('cm-login-btn');
    var contentEl = document.getElementById('cm-content');
    var countEl = document.getElementById('cm-count');
    var statusEl = document.getElementById('cm-status');
    var listEl = document.getElementById('cm-list');
    var submitEl = document.getElementById('cm-submit');
    if(!API || !form) return;

    // 评论草稿按页面路径存本地，刷新后回填；只存正文，7 天过期
    var draftKey = 'yixiu.draft.' + PAGE;
    var draftTimer = null;
    function readDraft(){
      try{
        var raw = localStorage.getItem(draftKey);
        if(!raw) return null;
        var d = JSON.parse(raw);
        if(!d || typeof d.text !== 'string' || !d.at) return null;
        if(Date.now() - Number(d.at) > 7 * 24 * 60 * 60 * 1000){ localStorage.removeItem(draftKey); return null; }
        return d;
      }catch(e){ return null; }
    }
    function saveDraft(){
      try{
        if(!contentEl.value){ localStorage.removeItem(draftKey); return; }
        localStorage.setItem(draftKey, JSON.stringify({ text: contentEl.value, at: Date.now() }));
      }catch(e){ /* 隐私模式或容量满：静默降级 */ }
    }
    function clearDraft(){
      try{ localStorage.removeItem(draftKey); }catch(e){}
    }
    var draft = readDraft();
    if(draft){
      contentEl.value = draft.text || '';
      countEl.textContent = contentEl.value.length + ' / 500';
    }
    function onDraftInput(){
      countEl.textContent = contentEl.value.length + ' / 500';
      clearTimeout(draftTimer);
      draftTimer = setTimeout(saveDraft, 300);
    }

    // GitHub 登录态：未登录只显示登录闸门，登录后开放表单并自动署名
    var authUser = null;
    function applyAuth(user){
      authUser = user || null;
      form.hidden = !authUser;               // 未登录不开放评论输入
      if(gate) gate.hidden = !!authUser;
      var tip = document.getElementById('cm-auth-tip');
      if(authUser){
        if(!tip){
          tip = el('div', 'cm-auth-tip');
          tip.id = 'cm-auth-tip';
          form.insertBefore(tip, form.firstChild);
        }
        tip.innerHTML = '';
        var av = document.createElement('img');
        av.className = 'cm-auth-av';
        av.src = authUser.avatar_url || '';
        av.alt = '';
        var tx = document.createElement('span');
        tx.appendChild(el('b', '', '@' + authUser.login));
        tx.appendChild(document.createTextNode(' · 评论将以 GitHub 身份发布'));
        tip.appendChild(av);
        tip.appendChild(tx);
      }else if(tip){
        tip.parentNode.removeChild(tip);
      }
    }
    // 登录闸门按钮：调用全站登录入口，登录成功后跳回本页
    if(loginBtn){
      loginBtn.addEventListener('click', function(){
        if(window.YixiuAuth && window.YixiuAuth.loginUrl){
          location.href = window.YixiuAuth.loginUrl(location.pathname + location.search);
        }
      });
    }
    // 缓存的公开资料只用于即时展示；只有服务端确认的登录态才能用于评论署名
    function verifiedUser(d){
      return (d && d.verified && d.user) ? d.user : null;
    }
    if(window.YixiuAuth && window.YixiuAuth.state && window.YixiuAuth.state.ready){
      applyAuth(verifiedUser(window.YixiuAuth.state));
    }
    document.addEventListener('yixiu:auth', function(e){
      var next = verifiedUser(e.detail);
      var changed = next !== authUser;
      applyAuth(next);
      if(changed && loaded && stateReady()) load();   // 已加载才重载；未加载则等进入视口时用当前身份加载
    });
    function stateReady(){
      return !!(window.YixiuAuth && window.YixiuAuth.state && window.YixiuAuth.state.ready);
    }

    function setStatus(msg, kind){
      statusEl.textContent = msg || '';
      statusEl.className = 'cm-status' + (kind ? ' ' + kind : '');
      statusEl.style.display = msg ? 'block' : 'none';
    }
    function el(tag, cls, text){
      var n = document.createElement(tag);
      if(cls) n.className = cls;
      if(text != null) n.textContent = text;   // 一律 textContent，天然防 XSS
      return n;
    }
    function timeText(s){
      s = String(s || '');
      return s.length >= 16 ? s.slice(0, 16).replace('T', ' ') + ' (UTC)' : s;
    }
    function render(items){
      listEl.innerHTML = '';
      if(!items || !items.length){
        var empty = el('div', 'cm-empty');
        empty.appendChild(el('span', 'cm-empty-ic', '💬'));
        empty.appendChild(el('p', 'cm-empty-t', '还没有评论，来坐沙发吧'));
        listEl.appendChild(empty);
        return;
      }
      var h = el('div', 'cm-list-head', '共 ' + items.length + ' 条评论');
      listEl.appendChild(h);
      items.forEach(function(it){
        var card = el('div', 'cm-item');
        var av;
        if(it.github_avatar){
          av = document.createElement('img');
          av.className = 'cm-av cm-av-img';
          av.src = it.github_avatar;
          av.alt = '';
          av.referrerPolicy = 'no-referrer';
        }else{
          av = el('span', 'cm-av', String(it.name || '匿').trim().charAt(0).toUpperCase());
        }
        var body = el('div', 'cm-item-body');
        var top = el('div', 'cm-item-top');
        top.appendChild(el('b', 'cm-item-name', it.name || '匿名访客'));
        if(it.github_login){
          var badge = el('a', 'cm-gh-badge', 'GitHub');
          badge.href = 'https://github.com/' + encodeURIComponent(it.github_login);
          badge.target = '_blank';
          badge.rel = 'noopener noreferrer';
          top.appendChild(badge);
        }
        top.appendChild(el('span', 'cm-item-time', timeText(it.created_at)));
        body.appendChild(top);
        body.appendChild(el('p', 'cm-item-tx', it.content));
        card.appendChild(av);
        card.appendChild(body);
        listEl.appendChild(card);
      });
    }
    var loaded = false;   // 评论区是否已进入视口并加载过
    function load(){
      loaded = true;
      setStatus('正在加载评论…');
      // 未登录时不带凭证：兼容尚未升级的后端，也避免无谓的跨域凭证请求
      var opt = { method:'GET' };
      if(authUser) opt.credentials = 'include';
      fetch(API + '?path=' + encodeURIComponent(PAGE), opt)
        .then(function(r){ return r.json(); })
        .then(function(d){
          if(!d || !d.ok) throw new Error(d && d.error || 'bad_response');
          render(d.items);
          setStatus('');
        })
        .catch(function(){ setStatus('评论服务暂时连不上，请稍后再试。', 'err'); });
    }
    // 评论区滚入视口才发请求，文章首屏不再等待 0.8s 的跨洲 D1 查询
    function setupLazyLoad(){
      var block = document.getElementById('comments') || listEl;
      if(!block || !('IntersectionObserver' in window)){ load(); return; }
      var io = new IntersectionObserver(function(entries){
        for(var i = 0; i < entries.length; i++){
          if(entries[i].isIntersecting){ io.disconnect(); load(); break; }
        }
      }, { rootMargin: '200px 0px' });   // 提前 200px 预加载，滚动时无感
      io.observe(block);
    }
    contentEl.addEventListener('input', onDraftInput);
    form.addEventListener('submit', function(e){
      e.preventDefault();
      if(!authUser){ setStatus('请先登录 GitHub 后再发表评论。', 'err'); return; }
      var content = contentEl.value.trim();
      if(!content){ setStatus('评论内容不能为空。', 'err'); return; }
      submitEl.disabled = true;
      submitEl.textContent = '提交中…';
      setStatus('');
      var postOpt = {
        method:'POST',
        credentials:'include',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ path: PAGE, content: content })
      };
      fetch(API, postOpt)
        .then(function(r){ return r.json(); })
        .then(function(d){
          if(!d || !d.ok) throw new Error(d && d.error || 'bad_response');
          clearTimeout(draftTimer);
          clearDraft();
          contentEl.value = '';
          countEl.textContent = '0 / 500';
          load();
        })
        .catch(function(err){
          var msg = err && err.message;
          setStatus(msg === 'rate_limited' ? '发得太快啦，歇一会儿再发。'
            : msg === 'login_required' ? '登录状态已失效，请重新登录后再发表评论。'
            : '提交失败，请稍后再试。', 'err');
        })
        .then(function(){
          submitEl.disabled = false;
          submitEl.textContent = '发表评论';
        });
    });
    setupLazyLoad();
  })();
  </script>

  <% } else if(cmReady && cmProvider === 'giscus'){ %>
  <div class="cm-body">
    <script src="https://giscus.app/client.js"
      data-repo="<%= String(g.repo).trim() %>"
      data-repo-id="<%= String(g.repo_id).trim() %>"
      data-category="<%= String(g.category || 'General').trim() %>"
      data-category-id="<%= String(g.category_id).trim() %>"
      data-mapping="<%= String(g.mapping || 'pathname').trim() %>"
      data-strict="0"
      data-reactions-enabled="<%= g.reactions === false ? '0' : '1' %>"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="<%= String(g.lang || 'zh-CN').trim() %>"
      data-loading="lazy"
      crossorigin="anonymous" async></script>
  </div>

  <% } else if(cmReady && cmProvider === 'twikoo'){ %>
  <div class="cm-body" id="cm-body"></div>
  <script src="<%= String(tk.cdn || 'https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.min.js').trim() %>"></script>
  <script>
    var TW_ENV = <%- jsLit(tk.env_id) %>;
    if(window.twikoo){ twikoo.init({ envId:TW_ENV, el:'#cm-body', lang:'zh-CN' }); }
  </script>

  <% } else if(cmReady && cmProvider === 'waline'){ %>
  <link rel="stylesheet" href="<%= String(wa.css || 'https://unpkg.com/@waline/client@v3/dist/waline.css').trim() %>">
  <div class="cm-body" id="cm-body"></div>
  <script type="module">
    var WA_CDN = <%- jsLit(wa.cdn || 'https://unpkg.com/@waline/client@v3/dist/waline.js') %>;
    var WA_URL = <%- jsLit(wa.server_url) %>;
    import(WA_CDN).then(function(m){ m.init({ el:'#cm-body', serverURL:WA_URL, lang:'zh-CN' }); });
  </script>

  <% } else { %>
  <div class="cm-pending">
    <div class="cm-pending-ic" aria-hidden="true">&#128172;</div>
    <div class="cm-pending-t">评论区待接入</div>
    <p class="cm-pending-d">本站是静态站点，评论需要接入后端服务。推荐用 <b>Cloudflare Workers + D1</b> 自建（免费额度够用、数据自己掌握），部署后把 API 地址填进站点根 <code>_config.yml</code> 的 <code>services.api.base</code> 即可启用。</p>
    <div class="cm-pending-tags"><span>Cloudflare</span><span>Giscus</span><span>Twikoo</span><span>Waline</span></div>
  </div>
  <% } %>
</section>
