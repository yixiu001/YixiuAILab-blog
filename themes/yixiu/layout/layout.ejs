<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <link rel="stylesheet" href="<%= url_for('/css/style.css') %>">
  <% var authCfg = theme.auth || {}; %>
  <script>
    window.__YIXIU_AUTH = {
      enable: <%= authCfg.enable === true ? 'true' : 'false' %>,
      api: <%- JSON.stringify(String(authCfg.api || '')).replace(/</g, '\\u003c') %>
    };
  </script>
  <%- css([]) %>
</head>
<body>
  <%- partial('_partial/header') %>
  <main class="page-main"><%- body %></main>
  <%- partial('_partial/footer') %>
  <script src="<%= url_for('/js/qrcode.min.js') %>"></script>
  <script src="<%= url_for('/js/auth.js') %>"></script>
  <script src="<%= url_for('/js/main.js') %>"></script>
</body>
</html>
